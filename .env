# Copy to .env and fill in real values before deploying.
# docker-compose.yml reads these for variable substitution.

# Required: secrets for Payload CMS and JWT signing
PAYLOAD_SECRET=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-long-random-string

# Initial admin user for the Payload admin panel (/admin)
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123456
